PORT=5000
MONGO_URI=mongodb://localhost:27017/anime-tracker
JWT_SECRET=change-me-generate-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
ANILIST_API_URL=https://graphql.anilist.co
# Number of reverse proxies in front of the API (0 = none). Set 1 on Render/Nginx/etc.
TRUST_PROXY=0
# NODE_ENV=production requires JWT_SECRET of at least 32 characters and HTTPS (secure cookie).
